# ---------------------------------------------------------------------------
# NexERP — environment template
# Copy to `.env.local` and adjust. Vite only exposes VITE_* to the bundle.
# ---------------------------------------------------------------------------

# Root URL of the Spring Boot backend (server.servlet.context-path=/api)
VITE_API_BASE_URL=http://localhost:8080/api

# WebSocket endpoint used for real-time events (stock alerts, invoice updates)
VITE_SOCKET_URL=ws://localhost:8080/ws

# When "false", RTK Query hits VITE_API_BASE_URL for real.
# Left as "true" the app serves in-memory fixtures so the UI is fully
# navigable before the backend is running.
VITE_USE_MOCKS=true

# Branding
VITE_APP_NAME=NexERP
VITE_SUPPORT_EMAIL=support@nexerp.io
